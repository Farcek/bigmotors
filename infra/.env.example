# Local-only defaults. Compose does not load the app-level .env files.
POSTGRES_DB=bigmotors
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_PORT=64401
WEBSITE_PORT=64400
SYSOP_SERVER_PORT=64402
SYSOP_APP_PORT=64403
PGDATA_PATH=./.docker/bigmotors_pgdata
FILES_DATA_PATH=./.docker/files

# Full, URL-encoded credentials; defaults point to the Compose DB.
# DATABASE_URL=postgresql://postgres:postgres@bigmotors-db:5432/bigmotors
# MIGRATION_DATABASE_URL=postgresql://postgres:postgres@bigmotors-db:5432/bigmotors

# Keep production upload protection. Only use development for trusted local testing.
SYSOP_NODE_ENV=production
FILE_UPLOAD_MAX_BYTES=20971520
