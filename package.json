{
  "name": "@bigmotors/bm-website",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev:website": "pnpm --filter \"@bigmotors/website^...\" build && pnpm --filter @bigmotors/website dev",
    "build:website": "pnpm --filter @bigmotors/website... build",
    "start:website": "pnpm --filter @bigmotors/website start",
    "typecheck:website": "pnpm --filter \"@bigmotors/website^...\" build && pnpm --filter @bigmotors/website typecheck",
    "dev:seed:vehicles": "pnpm --filter @bigmotors/sysop-server dev:seed:vehicles",
    "dev:app": "pnpm --filter \"@bigmotors/sysop-app^...\" build && pnpm --filter @bigmotors/sysop-app dev",
    "build:app": "pnpm --filter @bigmotors/sysop-app... build",
    "typecheck:app": "pnpm --filter \"@bigmotors/sysop-app^...\" build && pnpm --filter @bigmotors/sysop-app typecheck",
    "test:app": "pnpm --filter \"@bigmotors/sysop-app^...\" build && pnpm --filter @bigmotors/sysop-app test",
    "preview:app": "pnpm --filter @bigmotors/sysop-app preview",
    "dev:server": "pnpm --filter \"@bigmotors/sysop-server^...\" build && pnpm --filter @bigmotors/sysop-server dev",
    "build:server": "pnpm --filter @bigmotors/sysop-server... build",
    "start:server": "pnpm --filter @bigmotors/sysop-server start",
    "typecheck:server": "pnpm --filter \"@bigmotors/sysop-server^...\" build && pnpm --filter @bigmotors/sysop-server typecheck",
    "test:server": "pnpm --filter \"@bigmotors/sysop-server^...\" build && pnpm --filter @bigmotors/sysop-server test",
    "dev:dti": "pnpm build:core && pnpm --filter @bigmotors/sysop-dti dev",
    "build:dti": "pnpm --filter @bigmotors/sysop-dti... build",
    "typecheck:dti": "pnpm build:core && pnpm --filter @bigmotors/sysop-dti typecheck",
    "test:dti": "pnpm build:core && pnpm --filter @bigmotors/sysop-dti test",
    "build:core": "pnpm --filter @bigmotors/core build",
    "typecheck:core": "pnpm --filter @bigmotors/core typecheck",
    "build:db": "pnpm --filter @bigmotors/db... build",
    "typecheck:db": "pnpm build:core && pnpm --filter @bigmotors/db typecheck",
    "test:db": "pnpm build:core && pnpm --filter @bigmotors/db test",
    "db:generate": "pnpm --filter @bigmotors/db db:generate",
    "db:migrate": "pnpm --filter @bigmotors/db db:migrate",
    "db:reset": "pnpm --filter @bigmotors/db db:reset",
    "db:seed": "pnpm --filter @bigmotors/db db:seed"
  },
  "engines": {
    "node": ">=24.11.0 <25"
  }
}
