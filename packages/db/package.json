{
  "name": "@bigmotors/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": { "types": "./dist/index.d.mts", "import": "./dist/index.mjs" },
    "./schema": { "types": "./dist/schema/index.d.mts", "import": "./dist/schema/index.mjs" },
    "./schema-hooks": { "types": "./dist/schema-hooks.d.mts", "import": "./dist/schema-hooks.mjs" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsdown", "dev": "tsdown --watch", "typecheck": "tsc --noEmit",
    "test": "node --import=tsx --test test/*.test.ts"
  },
  "dependencies": { "@bigmotors/core": "workspace:*", "drizzle-orm": "0.45.2", "pg": "8.23.0" },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8", "@types/pg": "8.23.1", "@types/node": "24.13.3",
    "tsdown": "0.23.0", "tsx": "4.23.13", "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.11.0 <25"
  }
}
